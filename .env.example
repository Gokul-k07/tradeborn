# Optional PUBLIC HTTPS form endpoint, or same-origin /api/enquiry path.
# Empty = preview mode. Never put private keys or email credentials in VITE_* variables.
# Contract and server-side abuse requirements: see INTEGRATIONS.md.
VITE_CONTACT_ENDPOINT=

# Optional public canonical HTTPS origin (no path/query).
# Vercel production-domain metadata is used automatically when available.
VITE_SITE_URL=
